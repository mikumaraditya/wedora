# Wedora Backend Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/wedora?retryWrites=true&w=majority

# JWT Authentication Secrets (min 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here

# Redis Connection (BullMQ Queue & CSV Import Cache)
REDIS_URL=redis://localhost:6379

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Transactional Email Configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Wedora <noreply@example.com>"

# Google OAuth (Backend token audience verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
